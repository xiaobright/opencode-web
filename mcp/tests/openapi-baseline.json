{
  "openapi": "3.1.0",
  "info": {
    "title": "opencode HttpApi",
    "version": "0.0.1",
    "description": "Experimental HttpApi surface for selected instance routes."
  },
  "x-source": "anomalyco/opencode@654b79b27e79da735d6b07d766c8d7431a71d1b7/packages/protocol/openapi.json; operation inputs and transitive schemas only",
  "paths": {
    "/api/session": {
      "post": {
        "operationId": "session.create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Session.ID"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "parentID": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Session.ID"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "agent": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Agent.ID"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "model": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Model.Ref"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "location": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Location.PublicRef"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "metadata": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Session.Metadata"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "permissions": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Permission.Ruleset"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      },
      "get": {
        "operationId": "session.list",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of sessions to return. Defaults to the newest 50 sessions."
            },
            "required": false
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Session order for the first page. Use desc for newest first or asc for oldest first."
            },
            "required": false
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "parentID",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Session.ID"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "null"
                      ]
                    }
                  ],
                  "description": "Filter by parent session. Use null to return only root sessions."
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "directory",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AbsolutePath"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "project",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Project.ID"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "subpath",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RelativePath"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SessionsCursor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          }
        ]
      }
    },
    "/api/session/{sessionID}": {
      "get": {
        "operationId": "session.get",
        "parameters": [
          {
            "name": "sessionID",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Session.ID"
            },
            "required": true
          }
        ]
      }
    },
    "/api/session/active": {
      "get": {
        "operationId": "session.active",
        "parameters": []
      }
    },
    "/api/session/{sessionID}/inbox": {
      "get": {
        "operationId": "session.inbox.list",
        "parameters": [
          {
            "name": "sessionID",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Session.ID"
            },
            "required": true
          }
        ]
      }
    },
    "/api/session/{sessionID}/message": {
      "get": {
        "operationId": "session.message.list",
        "parameters": [
          {
            "name": "sessionID",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Session.ID"
            },
            "required": true
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of messages to return. When omitted, the endpoint returns its default page size."
            },
            "required": false
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Message order for the first page. Use desc for newest first or asc for oldest first."
            },
            "required": false
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "Opaque pagination cursor returned as cursor.previous or cursor.next in the previous response. Do not combine with order."
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "agent-switched",
                    "model-switched",
                    "location-switched",
                    "user",
                    "synthetic",
                    "system",
                    "skill",
                    "shell",
                    "assistant",
                    "compaction"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by message type before pagination. When omitted, all message types are returned. Pass the same type when following cursors."
            },
            "required": false
          }
        ]
      }
    },
    "/api/session/{sessionID}/interrupt": {
      "post": {
        "operationId": "session.interrupt",
        "parameters": [
          {
            "name": "sessionID",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Session.ID"
            },
            "required": true
          },
          {
            "name": "resume",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          }
        ]
      }
    },
    "/api/experimental/session/{sessionID}/wait": {
      "post": {
        "operationId": "experimental.session.wait",
        "parameters": [
          {
            "name": "sessionID",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Session.ID"
            },
            "required": true
          }
        ]
      }
    },
    "/api/model": {
      "get": {
        "operationId": "model.list",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "directory": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false,
            "style": "deepObject",
            "explode": true
          }
        ]
      }
    },
    "/api/session/{sessionID}/prompt": {
      "post": {
        "operationId": "session.prompt",
        "parameters": [
          {
            "name": "sessionID",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Session.ID"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Session.Message.ID"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PromptInput.FileAttachment"
                    }
                  },
                  "agents": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Prompt.AgentAttachment"
                    }
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PromptInput.SkillAttachment"
                    }
                  },
                  "metadata": {
                    "type": "object"
                  },
                  "delivery": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Session.Inbox.Delivery"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "resume": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/experimental/session/{sessionID}/instructions/entries/{key}": {
      "put": {
        "operationId": "experimental.session.instructions.entry.put",
        "parameters": [
          {
            "name": "sessionID",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Session.ID"
            },
            "required": true
          },
          {
            "name": "key",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/InstructionEntry.Key"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {}
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Session.ID": {
        "type": "string",
        "pattern": "^ses"
      },
      "Agent.ID": {
        "type": "string"
      },
      "Model.Ref": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "providerID": {
            "$ref": "#/components/schemas/Provider.ID"
          },
          "variant": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "providerID"
        ],
        "additionalProperties": false
      },
      "Provider.ID": {
        "type": "string"
      },
      "Location.PublicRef": {
        "type": "object",
        "properties": {
          "directory": {
            "$ref": "#/components/schemas/AbsolutePath"
          }
        },
        "required": [
          "directory"
        ],
        "additionalProperties": false
      },
      "AbsolutePath": {
        "type": "string"
      },
      "Session.Metadata": {
        "type": "object"
      },
      "Permission.Ruleset": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Permission.Rule"
        }
      },
      "Permission.Rule": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "effect": {
            "$ref": "#/components/schemas/Permission.Effect"
          }
        },
        "required": [
          "action",
          "resource",
          "effect"
        ],
        "additionalProperties": false
      },
      "Permission.Effect": {
        "type": "string",
        "enum": [
          "allow",
          "deny",
          "ask"
        ]
      },
      "Project.ID": {
        "type": "string"
      },
      "RelativePath": {
        "type": "string"
      },
      "SessionsCursor": {
        "type": "string",
        "description": "Opaque pagination cursor returned as cursor.previous or cursor.next in the previous response."
      },
      "Session.Message.ID": {
        "type": "string",
        "pattern": "^msg_"
      },
      "PromptInput.FileAttachment": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "mention": {
            "$ref": "#/components/schemas/Prompt.Mention"
          }
        },
        "required": [
          "uri"
        ],
        "additionalProperties": false
      },
      "Prompt.Mention": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      },
      "Prompt.AgentAttachment": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "mention": {
            "$ref": "#/components/schemas/Prompt.Mention"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "PromptInput.SkillAttachment": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Skill.ID"
          },
          "mention": {
            "$ref": "#/components/schemas/Prompt.Mention"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "Skill.ID": {
        "type": "string"
      },
      "Session.Inbox.Delivery": {
        "type": "string",
        "enum": [
          "steer",
          "queue"
        ]
      },
      "InstructionEntry.Key": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "description": "Instruction entry key (lowercase alphanumerics plus . _ -)"
      }
    }
  }
}
