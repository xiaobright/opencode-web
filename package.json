{
  "name": "opencode-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Local web UI and tray icon for the opencode background service",
  "scripts": {
    "start": "bun run src/start.mjs",
    "tray": "bun run scripts/tray.mjs",
    "standby": "bun run scripts/tray.mjs --lazy",
    "install-hook": "bun run scripts/install-hook.mjs",
    "uninstall-hook": "bun run scripts/install-hook.mjs --uninstall",
    "mcp": "node mcp/index.mjs",
    "test:mcp": "bun test mcp/tests"
  }
}
